<?xml version="1.0"?>
<ruleset name="Quick AdSense WordPress Coding Standards">
	<description>Apply WordPress Coding Standards to first-party plugin PHP.</description>
	<arg name="extensions" value="php"/>
	<arg name="cache" value=".cache/phpcs.cache"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="20"/>
	<arg value="ps"/>
	<ini name="memory_limit" value="1024M"/>
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/includes/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/bootstrap.php</exclude-pattern>

	<rule ref="WordPress-Extra">
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
		<!-- Public legacy helper signatures predate PHP named arguments. -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="quick_adsense_echo_ad_code"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/tests/phpunit/*</exclude-pattern>
		<!-- Legacy public widget class; moving it would add an unnecessary loader migration. -->
		<exclude-pattern>/includes/widgets.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>/tests/phpunit/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>/tests/phpunit/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.EnqueuedResources">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/characterization.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>/tests/characterization.php</exclude-pattern>
	</rule>
</ruleset>
